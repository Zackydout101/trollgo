{
  "name": "pokemon-go-world",
  "private": true,
  "version": "2.0.0",
  "description": "A Pokémon GO style real-world 3D map game built with Next.js, MapLibre and three.js",
  "scripts": {
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "maplibre-gl": "^6.18.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "react-three-map": "^1.0.2",
    "three": "^0.187.0",
    "three-stdlib": "^2.36.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2"
  }
}
